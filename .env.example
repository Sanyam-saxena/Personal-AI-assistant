# ─────────────────────────────────────────────────────────────────────────────
# AI Assistant Backend — .env.example
# cp .env.example .env  then fill in real values.
# ⚠  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Valid values: development, staging, production
ENVIRONMENT=development

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=60

# Maximum request body size in bytes (32 KB default)
MAX_REQUEST_BODY_BYTES=32768

APP_TITLE=AI Assistant Backend
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Default: Streamlit frontend origin.  Use "*" for local dev only.
# Production: explicit origins, e.g. https://myfrontend.com
CORS_ORIGINS=http://localhost:8501

# Comma-separated list of trusted proxy IPs (e.g. 10.0.0.1,192.168.1.1). Empty ignores X-Forwarded-For.
TRUSTED_PROXIES=

# false in production to hide /docs and /redoc
OPENAPI_ENABLED=true
